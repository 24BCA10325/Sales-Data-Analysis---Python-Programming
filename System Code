def revenue(s):
    return s["qty"] * s["price"]

def display_records():
    print("\nALL SALES RECORDS")
    print("-" * 75)
    for s in sales:
        print(s["date"], s["order"], s["product"],
              s["category"], s["qty"], revenue(s))

def summary():
    total = sum(revenue(s) for s in sales)
    units = sum(s["qty"] for s in sales)
    orders = len(set(s["order"] for s in sales))

    print("\nOVERALL SALES SUMMARY")
    print("Total records:", len(sales))
    print("Unique orders:", orders)
    print("Units sold:", units)
    print("Total revenue: Rs.", format(total, ",.2f"))
    print("Average order value: Rs.", format(total/orders, ",.2f"))

def product_analysis():
    totals = defaultdict(lambda: [0, 0])

    for s in sales:
        totals[s["product"]][0] += s["qty"]
        totals[s["product"]][1] += revenue(s)

    print("\nPRODUCT PERFORMANCE")
    for product, values in sorted(
        totals.items(), key=lambda x: x[1][1], reverse=True
    ):
        print(product, "| Quantity:", values[0],
              "| Revenue: Rs.", format(values[1], ",.2f"))

    best = max(totals, key=lambda p: totals[p][0])
    print("Best-selling product:", best)

def category_analysis():
    totals = defaultdict(float)

    for s in sales:
        totals[s["category"]] += revenue(s)

    print("\nCATEGORY ANALYSIS")
    for category, amount in sorted(
        totals.items(), key=lambda x: x[1], reverse=True
    ):
        print(category, ": Rs.", format(amount, ",.2f"))

def daily_revenue():
    totals = defaultdict(float)

    for s in sales:
        totals[s["date"]] += revenue(s)

    print("\nDAILY REVENUE")
    for day, amount in sorted(totals.items()):
        print(day, ": Rs.", format(amount, ",.2f"))

def search_product():
    name = input("Enter product name: ").lower()
    found = [s for s in sales if name in s["product"].lower()]

    if found:
        for s in found:
            print(s["product"], "| Quantity:", s["qty"],
                  "| Revenue:", revenue(s))
    else:
        print("No matching product found.")

def generate_report():
    print("\nSALES ANALYSIS REPORT")
    print("=" * 35)
    summary()
    product_analysis()
    category_analysis()
    print("\nReport generation completed.")

